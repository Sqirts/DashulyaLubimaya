* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  color: #222;
  background: #f5f5f5;
}

header, main, footer {
  max-width: 900px;
  margin: 0 auto;
  padding: 20px;
}

nav a {
  margin-right: 15px;
  text-decoration: none;
  color: #0066cc;
}

nav a:hover {
  text-decoration: underline;
}